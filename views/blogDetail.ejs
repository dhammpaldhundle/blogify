<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    
    <title>blog-detail</title>
  </head>

  <body>
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
    <img src="<%= blog.thumbnailURL %>" width="500px" alt="Blog Thumbnail" />
     <p style="white-space: pre-wrap;"><%= blog.body %></p>

    <div class="d-flex align-items-center gap-2">
        <img
          src="<%= blog.createdBy.userProfileImgUrl || '/uploads/raw/userIMG.png' %>"
          width="50"
          height="50"
          alt="User Profile Picture"
          style="object-fit: cover; border-radius: 50%;"
          onerror="this.onerror=null; this.src='/uploads/raw/userIMG.png';"
        />
        <p class="mb-0"><%= blog.createdBy.fullname %></p>
      </div>


      <div class="conatainer mt-4">
        <h3>Comments</h3>
        <% if (locals.user) { %>
          <form action="/blog/<%= blog._id %>/comment" method="post">
            <div>
              <input type="text" name="comment" id="comment" placeholder="write your comment" required>
              <button class="btn btn-sm btn-primary" type="submit">Add</button>
            </div>
          </form>


          <% if (comments.length) { %>
          <% comments.forEach((comment) => { %>
            <div class="d-flex align-items-center gap-2 mt-3">
              <img
                src="<%= comment.commentedBy ? comment.commentedBy.userProfileImgUrl : '/uploads/raw/userIMG.png' %>"
                width="50"
                height="50"
                alt="Commenter profile picture"
                style="object-fit: cover; border-radius: 50%;"
                onerror="this.onerror=null; this.src='/uploads/raw/userIMG.png';"
              />
              <div>
                <p class="mb-0"><%= comment.commentedBy ? comment.commentedBy.fullname : 'Unknown user' %></p>
                <p class="mb-0"><%= comment.comment %></p>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p>No comments yet.</p>
        <% } %>
      </div>
        <% } %>

        

    <%- include("partials/script") %>
    </div>
  </body>
</html>